# Optional. Any endpoint that accepts a JSON POST and sends the mail
# (Resend, Postmark, a Zapier/Make hook, or your own SMTP service).
#
# While this is unset, /api/enquiry validates the specification and reports
# delivered:false, and the form falls back to opening the visitor's mail
# client with the enquiry already composed — so nothing is lost.
ENQUIRY_WEBHOOK_URL=

# Canonical origin. Used for metadataBase, sitemap and structured data.
# Leave unset locally; set it on every deployment.
NEXT_PUBLIC_SITE_URL=

# Set to 1 on any deployment that is not the real launch (client demo,
# staging, preview). Blocks indexing via robots.txt and the meta tag.
NEXT_PUBLIC_NOINDEX=
